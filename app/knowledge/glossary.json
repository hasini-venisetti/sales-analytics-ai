{
  "metrics": {
    "revenue": {
      "canonical": "net_revenue",
      "synonyms": ["revenue", "sales", "turnover", "total sales", "net revenue", "earnings", "collections"],
      "definition": "Quantity * Unit_price - Discount_amount for Completed orders with Quantity > 0 and Unit_price not null.",
      "formula": "(Quantity * Unit_price) - Discount_amount"
    },
    "gross_revenue": {
      "canonical": "gross_revenue",
      "synonyms": ["gross revenue", "gross sales", "total value before discount"],
      "definition": "Quantity * Unit_price before subtracting discounts.",
      "formula": "Quantity * Unit_price"
    },
    "average_order_value": {
      "canonical": "aov",
      "synonyms": ["aov", "average order value", "average revenue per order", "mean order value", "order average"],
      "definition": "Total net revenue divided by total completed order count.",
      "formula": "SUM(net_revenue) / COUNT(Transaction_Id)"
    },
    "units": {
      "canonical": "quantity",
      "synonyms": ["units", "volume", "quantity", "number of items", "pieces sold", "units sold"],
      "definition": "Physical count of units ordered.",
      "formula": "SUM(Quantity)"
    },
    "returns": {
      "canonical": "returns_value",
      "synonyms": ["returns", "refunds", "returned orders", "return rate", "returned value"],
      "definition": "Orders marked with Status = 'Returned'. Quarantined from default revenue metrics.",
      "formula": "SUM(gross_revenue) WHERE Status = 'Returned'"
    },
    "discount": {
      "canonical": "discount_impact",
      "synonyms": ["discount", "discounts", "discount given", "discount percentage", "discount impact"],
      "definition": "Monetary reduction granted on orders.",
      "formula": "(SUM(Discount_amount) / SUM(gross_revenue)) * 100"
    }
  },
